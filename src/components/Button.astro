---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	size?: 'default' | 'small';
}

const { href, size = 'default', class: className, ...rest } = Astro.props;

const sizeClasses = size === 'small'
	? 'px-8 py-4 text-base'
	: 'px-8 py-5 text-2xl';
---

<a
	href={href}
	class:list={[
		'inline-flex items-center justify-center rounded-[30px] bg-pink-salmon font-nav font-semibold text-white transition-opacity hover:opacity-90 hover:no-underline',
		sizeClasses,
		className,
	]}
	{...rest}
>
	<slot />
</a>

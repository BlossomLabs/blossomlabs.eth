---
import Button from './Button.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	link: string;
	logo?: string;
	logoBackground?: string;
}

const { title, description, image, link, logo, logoBackground = '#000000' } = Astro.props;
---

<div class="project-card mx-auto w-full max-w-[1378px] overflow-hidden rounded-[15px] bg-white shadow-[0_5px_10px_rgba(0,0,0,0.05)]">
	<div class="project-card__inner flex flex-col">
		<div
			class="aspect-673/498 flex w-full shrink-0 items-center justify-center overflow-hidden rounded-[15px] md:w-[49%]"
			style={logo ? `background-color: ${logoBackground}` : undefined}
		>
			{logo ? (
				<img
					src={logo}
					alt={title}
					class="max-h-full max-w-full object-contain p-8"
				/>
			) : (
				<img
					src={image}
					alt={title}
					class="h-full w-full rounded-none object-cover"
				/>
			)}
		</div>
		<div class="flex flex-1 flex-col justify-center gap-6 p-8 md:p-12">
			<h3 class="text-2xl font-medium leading-tight tracking-normal text-green-dark md:text-[32px]">
				{title}
			</h3>
			<p class="text-base font-light leading-tight text-green-muted md:text-2xl">
				{description}
			</p>
			<div>
				<Button href={link} size="small" target="_blank">Visit site</Button>
			</div>
		</div>
	</div>
</div>

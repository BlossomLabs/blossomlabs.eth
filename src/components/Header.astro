---
const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-[0_5px_10px_rgba(0,0,0,0.05)]">
	<nav class="mx-auto flex h-[60px] max-w-[1728px] items-center justify-between px-10">
		<a href="/" class="flex items-center">
			<img src="/img/logo-blossom.svg" alt="Blossom Labs" class="h-[26px] w-auto" />
		</a>
		<div class="hidden items-center gap-8 font-nav md:flex">
			<a
				href="#products"
				class="text-[20px] font-light tracking-[0.05em] text-green-dark hover:no-underline hover:opacity-80"
			>
				Products
			</a>
			<a
				href="/blog"
				class="text-[20px] font-light tracking-[0.05em] text-green-dark hover:no-underline hover:opacity-80"
			>
				Blog
			</a>
			<a
				href="#contact"
				class="text-[20px] font-semibold tracking-[0.05em] text-green-dark hover:no-underline hover:opacity-80"
			>
				Contact
			</a>
		</div>
		<button
			id="mobile-menu-btn"
			class="flex flex-col gap-1.5 md:hidden"
			aria-label="Toggle menu"
		>
			<span class="block h-0.5 w-6 bg-green-dark"></span>
			<span class="block h-0.5 w-6 bg-green-dark"></span>
			<span class="block h-0.5 w-6 bg-green-dark"></span>
		</button>
	</nav>
	<div id="mobile-menu" class="hidden bg-white px-10 pb-6 md:hidden">
		<a href="#products" class="block py-2 font-nav text-lg font-light tracking-[0.05em] text-green-dark">Products</a>
		<a href="/blog" class="block py-2 font-nav text-lg font-light tracking-[0.05em] text-green-dark">Blog</a>
		<a href="#contact" class="block py-2 font-nav text-lg font-semibold tracking-[0.05em] text-green-dark">Contact</a>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});
</script>

---
const today = new Date();
---

<footer class="bg-white">
	<div class="mx-auto flex max-w-[1728px] flex-col items-center justify-between gap-10 px-10 py-12 md:flex-row md:items-start">
		<div class="flex flex-col items-center gap-4 md:items-start">
			<img src="/img/logo-blossom.svg" alt="Blossom Labs" class="h-[70px] w-auto rounded-none" />
			<p class="text-2xl font-light tracking-[0.05em] text-green-muted">
				&copy; {today.getFullYear()} Blossom Labs
			</p>
		</div>

		<div class="flex flex-col items-center gap-3 md:items-start">
			<h3 class="text-[28px] font-normal tracking-[0.05em] text-green-dark">Follow us</h3>
			<a
				href="https://twitter.com/blossom_labs/"
				target="_blank"
				class="text-2xl font-light tracking-[0.05em] text-green-muted hover:text-green-dark"
			>
				Twitter
			</a>
			<a
				href="https://discordapp.com/invite/fmqrqhkjHY/"
				target="_blank"
				class="text-2xl font-light tracking-[0.05em] text-green-muted hover:text-green-dark"
			>
				Discord
			</a>
			<a
				href="https://github.com/blossomlabs/"
				target="_blank"
				class="text-2xl font-light tracking-[0.05em] text-green-muted hover:text-green-dark"
			>
				Github
			</a>
		</div>
	</div>
</footer>

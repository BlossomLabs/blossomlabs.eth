---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'work'>['data'];

const {
	title,
	summary,
	client,
	period,
	role,
	partners = [],
	stack = [],
	links = [],
	metrics = [],
	heroImage,
	heroImageAlt = '',
} = Astro.props;

const facts = [
	{ label: 'Client', value: client },
	{ label: 'Period', value: period },
	{ label: 'Our role', value: role },
];
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · Case study`} description={summary} />
	</head>

	<body class="bg-offwhite">
		<Header />
		<main class="pt-[60px]">
			{/* ───── Intro ───── */}
			<section class="bg-green-sage">
				<div class="mx-auto max-w-[1232px] px-6 pb-20 pt-16 md:pb-28 md:pt-24">
					<a href="/#past-projects" class="font-nav text-base tracking-[0.05em] text-offwhite/80 hover:text-offwhite">
						← Past projects
					</a>
					<p class="mt-10 font-nav text-base uppercase tracking-[0.2em] text-peach">Case study</p>
					<h1 class="mt-3 max-w-[900px] text-4xl font-semibold leading-[1.125] tracking-[0.02em] text-offwhite md:text-6xl">
						{title}
					</h1>
					<p class="mt-6 max-w-[760px] text-lg font-light leading-snug text-offwhite md:text-2xl">{summary}</p>
				</div>
			</section>

			{/* ───── Key figures ───── */}
			{metrics.length > 0 && (
				<section class="mx-auto -mt-10 max-w-[1232px] px-6">
					<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[15px] bg-green-light/40 shadow-[0_5px_10px_rgba(0,0,0,0.05)] md:grid-cols-4">
						{metrics.map((metric) => (
							<div class="flex flex-col-reverse gap-1 bg-white p-6 md:p-8">
								<dt class="text-sm font-light leading-snug text-green-muted md:text-base">{metric.label}</dt>
								<dd class="m-0 text-3xl font-semibold text-green-dark md:text-4xl">{metric.value}</dd>
							</div>
						))}
					</dl>
				</section>
			)}

			{/* ───── Body ───── */}
			<div class="mx-auto grid max-w-[1232px] gap-12 px-6 py-16 md:py-24 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-20">
				<aside class="lg:sticky lg:top-[100px] lg:self-start">
					<dl class="flex flex-col gap-6 border-t border-green-light pt-6">
						{facts.map((fact) => (
							<div>
								<dt class="font-nav text-sm uppercase tracking-[0.15em] text-green-sage">{fact.label}</dt>
								<dd class="m-0 mt-1 text-green-dark">{fact.value}</dd>
							</div>
						))}
						{partners.length > 0 && (
							<div>
								<dt class="font-nav text-sm uppercase tracking-[0.15em] text-green-sage">Partners</dt>
								<dd class="m-0 mt-1 text-green-dark">{partners.join(', ')}</dd>
							</div>
						)}
						{stack.length > 0 && (
							<div>
								<dt class="font-nav text-sm uppercase tracking-[0.15em] text-green-sage">Stack</dt>
								<dd class="m-0 mt-2 flex flex-wrap gap-2">
									{stack.map((item) => (
										<span class="rounded-full bg-peach px-3 py-1 text-sm text-green-dark">{item}</span>
									))}
								</dd>
							</div>
						)}
						{links.length > 0 && (
							<div>
								<dt class="font-nav text-sm uppercase tracking-[0.15em] text-green-sage">Links</dt>
								<dd class="m-0 mt-1 flex flex-col gap-1">
									{links.map((link) => (
										<a href={link.href} target="_blank" class="text-pink-coral">{link.label} ↗</a>
									))}
								</dd>
							</div>
						)}
					</dl>
				</aside>

				<article class="case-prose min-w-0">
					{heroImage && (
						<Image src={heroImage} alt={heroImageAlt} width={1200} class="mb-12 rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.1)]" />
					)}
					<slot />
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.case-prose {
		max-width: 760px;
		font-size: 1.125rem;
		font-weight: 300;
		line-height: 1.7;
		color: var(--color-green-muted);
	}
	.case-prose > * + * {
		margin-top: 1.25em;
	}
	.case-prose p {
		margin-bottom: 0;
	}
	.case-prose h2 {
		margin-top: 2.5em;
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.case-prose h3 {
		margin-top: 2em;
		font-size: 1.375rem;
		font-weight: 500;
	}
	.case-prose h2 + *,
	.case-prose h3 + * {
		margin-top: 0.75em;
	}
	.case-prose a {
		color: var(--color-pink-coral);
	}
	.case-prose strong {
		font-weight: 500;
		color: var(--color-green-dark);
	}
	.case-prose ul,
	.case-prose ol {
		padding-left: 1.5em;
	}
	.case-prose ul {
		list-style: disc;
	}
	.case-prose ol {
		list-style: decimal;
	}
	.case-prose li + li,
	.case-prose li > ul {
		margin-top: 0.5em;
	}
	.case-prose li::marker {
		color: var(--color-pink-salmon);
	}
	.case-prose blockquote {
		font-size: 1.25rem;
		color: var(--color-green-dark);
	}
	.case-prose table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		display: block;
		overflow-x: auto;
	}
	.case-prose th,
	.case-prose td {
		padding: 0.6em 1em 0.6em 0;
		border-bottom: 1px solid color-mix(in srgb, var(--color-green-light) 50%, transparent);
		text-align: left;
		vertical-align: top;
	}
	.case-prose th {
		font-weight: 500;
		color: var(--color-green-dark);
		border-bottom-color: var(--color-green-light);
	}
	.case-prose img {
		border-radius: 15px;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
	}
	.case-prose figure figcaption,
	.case-prose .caption {
		margin-top: 0.5em;
		font-size: 0.875rem;
		color: var(--color-green-sage);
	}
</style>
